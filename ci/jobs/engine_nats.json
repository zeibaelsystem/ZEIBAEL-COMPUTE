{
  "schema": 1,
  "jobs": [
    {
      "id": "nats",
      "runtime": "python",
      "runner": "ubuntu-24.04",
      "timeout_profile": "standard",
      "output_files": true,
      "commands": [
        [
          "bash",
          "ci/jobs/install_stage3_packages.sh",
          "nats"
        ],
        [
          "python",
          "-m",
          "pip",
          "install",
          "--disable-pip-version-check",
          "--no-input",
          "--only-binary=:all:",
          "nats-py==2.17.0"
        ],
        [
          "python",
          "scripts/stage3_compute.py",
          "nats"
        ]
      ]
    }
  ]
}
