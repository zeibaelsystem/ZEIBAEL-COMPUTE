{
  "schema": 1,
  "jobs": [
    {
      "id": "pytorch",
      "runtime": "python",
      "runner": "ubuntu-24.04",
      "timeout_profile": "long",
      "output_files": true,
      "commands": [
        [
          "python",
          "-m",
          "pip",
          "install",
          "--disable-pip-version-check",
          "--no-input",
          "--only-binary=:all:",
          "--index-url",
          "https://download.pytorch.org/whl/cpu",
          "torch==2.7.1+cpu"
        ],
        [
          "python",
          "scripts/extended_compute.py",
          "pytorch"
        ]
      ]
    }
  ]
}
