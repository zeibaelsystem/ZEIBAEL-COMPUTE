{
  "schema": 1,
  "jobs": [
    {
      "id": "nautilus_trader",
      "runtime": "python",
      "runner": "ubuntu-24.04",
      "timeout_profile": "standard",
      "output_files": true,
      "commands": [
        [
          "python",
          "-m",
          "pip",
          "install",
          "--disable-pip-version-check",
          "--no-input",
          "--only-binary=:all:",
          "nautilus_trader==1.231.0",
          "numpy==2.2.6",
          "pandas==2.3.3"
        ],
        [
          "python",
          "scripts/stage3_compute.py",
          "nautilus_trader"
        ]
      ]
    }
  ]
}
