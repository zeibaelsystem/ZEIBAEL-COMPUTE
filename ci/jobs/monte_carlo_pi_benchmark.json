      "timeout_profile": "standard",
      "commands": [
        [
          "python",
          "-m",
          "pip",
          "install",
          "--disable-pip-version-check",
          "--no-input",
          "--only-binary=:all:",
          "numpy==2.2.6"
        ],
        [
          "python",
          "scripts/monte_carlo_pi_benchmark.py",
          "--selftest"
        ],
        [
          "python",
          "scripts/monte_carlo_pi_benchmark.py"
        ]
      ]
    }
  ]
}
