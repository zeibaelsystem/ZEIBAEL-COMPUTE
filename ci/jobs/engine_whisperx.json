{
  "schema": 1,
  "jobs": [
    {
      "id": "whisperx",
      "runtime": "python",
      "runner": "ubuntu-24.04",
      "timeout_profile": "standard",
      "output_files": true,
      "commands": [
        [
          "bash",
          "ci/jobs/install_expansion_packages.sh",
          "whisperx"
        ],
        [
          "python",
          "-m",
          "pip",
          "install",
          "--disable-pip-version-check",
          "--no-input",
          "--index-url",
          "https://download.pytorch.org/whl/cpu",
          "torch==2.7.1+cpu",
          "torchvision==0.22.1+cpu",
          "torchaudio==2.7.1+cpu"
        ],
        [
          "python",
          "-m",
          "pip",
          "install",
          "--disable-pip-version-check",
          "--no-input",
          "--only-binary=:all:",
          "whisperx==3.3.4",
          "transformers==4.52.4",
          "huggingface-hub==0.31.4",
          "numpy==2.2.6"
        ],
        [
          "python",
          "scripts/expansion_compute.py",
          "whisperx"
        ]
      ]
    }
  ]
}
