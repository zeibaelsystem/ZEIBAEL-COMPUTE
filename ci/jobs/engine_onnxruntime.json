{
  "schema": 1,
  "jobs": [
    {
      "id": "onnxruntime",
      "runtime": "python",
      "runner": "ubuntu-24.04",
      "timeout_profile": "standard",
      "output_files": true,
      "commands": [
        [
          "python",
          "-m",
          "pip",
          "install",
          "--disable-pip-version-check",
          "--no-input",
          "--only-binary=:all:",
          "numpy==2.2.6",
          "onnx==1.17.0",
          "onnxruntime==1.22.1"
        ],
        [
          "python",
          "scripts/extended_compute.py",
          "onnxruntime"
        ]
      ]
    }
  ]
}
