{
  "schema": 1,
  "jobs": [
    {
      "id": "rust-backtest",
      "runtime": "rust",
      "runner": "ubuntu-24.04",
      "timeout_profile": "standard",
      "output_files": true,
      "requirements": {
        "os": "linux",
        "arch": "x64",
        "min_cpu": 4,
        "toolchains": [
          "rustc",
          "cargo"
        ]
      },
      "commands": [
        [
          "python",
          "scripts/rust_expansion.py",
          "backtest"
        ]
      ]
    }
  ]
}
