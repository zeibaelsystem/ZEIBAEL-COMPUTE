{
  "schema": 1,
  "jobs": [
    {
      "id": "idaes",
      "runtime": "python",
      "runner": "ubuntu-24.04",
      "timeout_profile": "standard",
      "output_files": true,
      "commands": [
        [
          "python",
          "-m",
          "pip",
          "install",
          "--disable-pip-version-check",
          "--no-input",
          "--only-binary=:all:",
          "idaes-pse==2.8.0",
          "pyomo==6.9.2",
          "pandas==2.2.3",
          "numpy==1.26.4"
        ],
        [
          "python",
          "scripts/expansion_compute.py",
          "idaes"
        ]
      ]
    }
  ]
}
