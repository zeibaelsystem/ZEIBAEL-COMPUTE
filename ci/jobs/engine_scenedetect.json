{
  "schema": 1,
  "jobs": [
    {
      "id": "scenedetect",
      "runtime": "python",
      "runner": "ubuntu-24.04",
      "timeout_profile": "standard",
      "output_files": true,
      "commands": [
        [
          "python",
          "-m",
          "pip",
          "install",
          "--disable-pip-version-check",
          "--no-input",
          "--only-binary=:all:",
          "scenedetect==0.6.6",
          "opencv-python-headless==4.11.0.86",
          "numpy==1.26.4"
        ],
        [
          "python",
          "scripts/expansion_compute.py",
          "scenedetect"
        ]
      ]
    }
  ]
}
