{
  "schema": 1,
  "jobs": [
    {
      "id": "ortools",
      "runtime": "python",
      "runner": "ubuntu-24.04",
      "timeout_profile": "standard",
      "output_files": true,
      "commands": [
        [
          "python",
          "-m",
          "pip",
          "install",
          "--disable-pip-version-check",
          "--no-input",
          "--only-binary=:all:",
          "ortools==9.12.4544"
        ],
        [
          "python",
          "scripts/expansion_compute.py",
          "ortools"
        ]
      ]
    }
  ]
}
