{
  "schema": 1,
  "jobs": [
    {
      "id": "browser_chromium",
      "runtime": "node",
      "runner": "auto",
      "timeout_profile": "long",
      "output_files": true,
      "requirements": {
        "os": "linux",
        "arch": "x64",
        "min_cpu": 4,
        "min_memory_gb": 8,
        "toolchains": [
          "node",
          "npm"
        ],
        "output_mb": 3
      },
      "commands": [
        [
          "npm",
          "--prefix",
          "ci/fixtures/web",
          "install",
          "--no-save",
          "--no-package-lock",
          "--ignore-scripts",
          "--no-audit",
          "--no-fund",
          "playwright@1.56.1"
        ],
        [
          "node",
          "ci/fixtures/web/node_modules/playwright/cli.js",
          "install",
          "--with-deps",
          "chromium"
        ],
        [
          "node",
          "ci/fixtures/web/browser_matrix.mjs",
          "chromium"
        ],
        [
          "node",
          "ci/fixtures/web/playwright_smoke.mjs"
        ]
      ]
    },
