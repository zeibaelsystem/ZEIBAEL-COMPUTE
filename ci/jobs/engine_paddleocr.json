{
  "schema": 1,
  "jobs": [
    {
      "id": "paddleocr",
      "runtime": "python",
      "runner": "ubuntu-24.04",
      "timeout_profile": "standard",
      "output_files": true,
      "commands": [
        [
          "bash",
          "ci/jobs/install_expansion_packages.sh",
          "paddleocr"
        ],
        [
          "python",
          "-m",
          "pip",
          "install",
          "--disable-pip-version-check",
          "--no-input",
          "--only-binary=:all:",
          "setuptools==80.9.0",
          "wheel==0.45.1"
        ],
        [
          "python",
          "-m",
          "pip",
          "install",
          "--disable-pip-version-check",
          "--no-input",
          "--no-build-isolation",
          "--no-deps",
          "https://files.pythonhosted.org/packages/ed/0e/5c61eedde9f6c87713e89d794f01e378cfd9565847d4576fa627d758c554/GPUtil-1.4.0.tar.gz#sha256=099e52c65e512cdfa8c8763fca67f5a5c2afb63469602d5dcb4d296b3661efb9"
        ],
        [
          "python",
          "-m",
          "pip",
          "install",
          "--disable-pip-version-check",
          "--no-input",
          "--only-binary=:all:",
          "paddlepaddle==3.0.0",
          "paddleocr==3.0.0",
          "huggingface-hub==0.31.4",
          "numpy==1.26.4",
          "pillow==11.2.1"
        ],
        [
          "python",
          "scripts/expansion_compute.py",
          "paddleocr"
        ]
      ]
    }
  ]
}
