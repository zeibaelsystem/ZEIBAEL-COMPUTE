{
  "schema": 1,
  "jobs": [
    {
      "id": "python-check",
      "runtime": "python",
      "runner": "ubuntu-24.04",
      "timeout_profile": "short",
      "commands": [
        [
          "python",
          "-m",
          "pip",
          "install",
          "--disable-pip-version-check",
          "--no-input",
          "--only-binary=:all:",
          "numpy==2.2.6"
        ],
        [
          "bash",
          "ci/jobs/install_media_tools.sh"
        ],
        [
          "python",
          "-m",
          "unittest",
          "discover",
          "-s",
          "tests",
          "-v"
        ]
      ]
    },
    {
      "id": "node-check",
      "runtime": "node",
      "runner": "ubuntu-24.04",
      "timeout_profile": "short",
      "commands": [
        [
          "node",
          "--version"
        ]
      ]
    }
  ]
}
