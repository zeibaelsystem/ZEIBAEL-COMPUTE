{
  "schema": 1,
  "jobs": [
    {
      "id": "wntr",
      "runtime": "python",
      "runner": "ubuntu-24.04",
      "timeout_profile": "standard",
      "output_files": true,
      "commands": [
        [
          "python",
          "-m",
          "pip",
          "install",
          "--disable-pip-version-check",
          "--no-input",
          "--only-binary=:all:",
          "wntr==1.3.2",
          "numpy==1.26.4",
          "six==1.17.0",
          "pandas==2.2.3",
          "setuptools==80.9.0"
        ],
        [
          "python",
          "scripts/expansion_compute.py",
          "wntr"
        ]
      ]
    }
  ]
}
