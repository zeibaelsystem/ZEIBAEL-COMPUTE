{
  "schema": 1,
  "jobs": [
    {
      "id": "docling",
      "runtime": "python",
      "runner": "ubuntu-24.04",
      "timeout_profile": "standard",
      "output_files": true,
      "commands": [
        [
          "python",
          "-m",
          "pip",
          "install",
          "--disable-pip-version-check",
          "--no-input",
          "--only-binary=:all:",
          "--index-url",
          "https://download.pytorch.org/whl/cpu",
          "torch==2.7.1+cpu"
        ],
        [
          "python",
          "-m",
          "pip",
          "install",
          "--disable-pip-version-check",
          "--no-input",
          "--only-binary=:all:",
          "docling==2.34.0",
          "pandas==2.2.3",
          "numpy==1.26.4"
        ],
        [
          "python",
          "scripts/expansion_compute.py",
          "docling"
        ]
      ]
    }
  ]
}
