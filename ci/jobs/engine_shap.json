{
  "schema": 1,
  "jobs": [
    {
      "id": "shap",
      "runtime": "python",
      "runner": "ubuntu-24.04",
      "timeout_profile": "standard",
      "output_files": true,
      "commands": [
        [
          "python",
          "-m",
          "pip",
          "install",
          "--disable-pip-version-check",
          "--no-input",
          "--only-binary=:all:",
          "shap==0.47.2",
          "numpy==1.26.4",
          "scikit-learn==1.6.1",
          "numba==0.61.2"
        ],
        [
          "python",
          "scripts/expansion_compute.py",
          "shap"
        ]
      ]
    }
  ]
}
