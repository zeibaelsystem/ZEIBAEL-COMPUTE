{
  "schema": 1,
  "jobs": [
    {
      "id": "dvc",
      "runtime": "python",
      "runner": "ubuntu-24.04",
      "timeout_profile": "standard",
      "output_files": true,
      "commands": [
        [
          "python",
          "-m",
          "pip",
          "install",
          "--disable-pip-version-check",
          "--no-input",
          "--only-binary=:all:",
          "dvc==3.67.1"
        ],
        [
          "python",
          "scripts/stage3_compute.py",
          "dvc"
        ]
      ]
    }
  ]
}
