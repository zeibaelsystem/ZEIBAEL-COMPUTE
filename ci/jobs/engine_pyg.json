{
  "schema": 1,
  "jobs": [
    {
      "id": "pyg",
      "runtime": "python",
      "runner": "ubuntu-24.04",
      "timeout_profile": "standard",
      "output_files": true,
      "commands": [
        [
          "python",
          "-m",
          "pip",
          "install",
          "--disable-pip-version-check",
          "--no-input",
          "--only-binary=:all:",
          "--index-url",
          "https://download.pytorch.org/whl/cpu",
          "torch==2.7.1+cpu",
          "torchvision==0.22.1+cpu",
          "torchaudio==2.7.1+cpu"
        ],
        [
          "python",
          "-m",
          "pip",
          "install",
          "--disable-pip-version-check",
          "--no-input",
          "--only-binary=:all:",
          "torch-geometric==2.8.1",
          "torch==2.7.1+cpu",
          "numpy==2.2.6"
        ],
        [
          "python",
          "scripts/stage3_compute.py",
          "pyg"
        ]
      ]
    }
  ]
}
