{
  "schema": 1,
  "jobs": [
    {
      "id": "statsforecast",
      "runtime": "python",
      "runner": "ubuntu-24.04",
      "timeout_profile": "standard",
      "output_files": true,
      "commands": [
        [
          "python",
          "-m",
          "pip",
          "install",
          "--disable-pip-version-check",
          "--no-input",
          "--only-binary=:all:",
          "statsforecast==2.0.1",
          "numpy==1.26.4",
          "pandas==2.2.3",
          "pyarrow==20.0.0",
          "numba==0.61.2"
        ],
        [
          "python",
          "scripts/expansion_compute.py",
          "statsforecast"
        ]
      ]
    }
  ]
}
