{
  "schema": 1,
  "jobs": [
    {
      "id": "pandapower",
      "runtime": "python",
      "runner": "ubuntu-24.04",
      "timeout_profile": "standard",
      "output_files": true,
      "commands": [
        [
          "python",
          "-m",
          "pip",
          "install",
          "--disable-pip-version-check",
          "--no-input",
          "--only-binary=:all:",
          "pandapower==3.1.2",
          "numpy==1.26.4",
          "pandas==2.2.3"
        ],
        [
          "python",
          "scripts/expansion_compute.py",
          "pandapower"
        ]
      ]
    }
  ]
}
