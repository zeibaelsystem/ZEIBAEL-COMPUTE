{
  "schema": 1,
  "jobs": [
    {
      "id": "qlib",
      "runtime": "python",
      "runner": "ubuntu-24.04",
      "timeout_profile": "standard",
      "output_files": true,
      "commands": [
        [
          "python",
          "-m",
          "pip",
          "install",
          "--disable-pip-version-check",
          "--no-input",
          "--only-binary=:all:",
          "setuptools==80.9.0",
          "wheel==0.45.1",
          "gym-notices==0.0.8",
          "cloudpickle==3.1.1"
        ],
        [
          "python",
          "-m",
          "pip",
          "install",
          "--disable-pip-version-check",
          "--no-input",
          "--no-build-isolation",
          "--no-deps",
          "https://files.pythonhosted.org/packages/ab/b1/eb05a423eb801ab7d0715d6a3b28d92589e30b437052553df19ca2087240/gym-0.26.2.tar.gz#sha256=e0d882f4b54f0c65f203104c24ab8a38b039f1289986803c7d02cdbe214fbcc4"
        ],
        [
          "python",
          "-m",
          "pip",
          "install",
          "--disable-pip-version-check",
          "--no-input",
          "--only-binary=:all:",
          "pyqlib==0.9.6",
          "pandas==2.2.3",
          "numpy==1.26.4"
        ],
        [
          "python",
          "scripts/expansion_compute.py",
          "qlib"
        ]
      ]
    }
  ]
}
