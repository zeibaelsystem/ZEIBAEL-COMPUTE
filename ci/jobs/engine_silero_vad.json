{
  "schema": 1,
  "jobs": [
    {
      "id": "silero_vad",
      "runtime": "python",
      "runner": "ubuntu-24.04",
      "timeout_profile": "standard",
      "output_files": true,
      "commands": [
        [
          "bash",
          "ci/jobs/install_expansion_packages.sh",
          "silero_vad"
        ],
        [
          "python",
          "-m",
          "pip",
          "install",
          "--disable-pip-version-check",
          "--no-input",
          "--only-binary=:all:",
          "--index-url",
          "https://download.pytorch.org/whl/cpu",
          "torch==2.7.1+cpu",
          "torchaudio==2.7.1+cpu"
        ],
        [
          "python",
          "-m",
          "pip",
          "install",
          "--disable-pip-version-check",
          "--no-input",
          "--only-binary=:all:",
          "silero-vad==5.1.2",
          "onnxruntime==1.22.1",
          "numpy==1.26.4"
        ],
        [
          "python",
          "scripts/expansion_compute.py",
          "silero_vad"
        ]
      ]
    }
  ]
}
